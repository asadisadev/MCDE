# Q17 Nested Tuple Access
students = (
    ("Ali", (85, 90, 88)),
    ("Sara", (92, 87, 95)),
    ("Ahmed", (78, 84, 80))
)

s2_second = students[1][1][1]

s1_scores = students[0][1]
s1_average = sum(s1_scores) / len(s1_scores)

s3_scores = students[2][1]
s3_highest = max(s3_scores)

print("Ali's Average:", s1_average)
print("Sara's Second Score:", s2_second)
print("Ahmed's Highest Score:", s3_highest)

