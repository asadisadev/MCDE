# Q9 Extract Data from Matrix
matrix = [
    [10, 20, 30],
    [40, 50, 60],
    [70, 80, 90]
]

main_diagonal = [
    matrix[0][0],
    matrix[1][1],
    matrix[2][2]
]

secondary_diagonal = [
    matrix[0][2],
    matrix[1][1],
    matrix[2][0]
]

middle_column = [
    matrix[0][1],
    matrix[1][1],
    matrix[2][1]
]

print("Main Diagonal:", main_diagonal)
print("Main Diagonal Sum:", sum(main_diagonal))

print("Secondary Diagonal:", secondary_diagonal)
print("Secondary Diagonal Sum:", sum(secondary_diagonal))

print("Middle Column:", middle_column)
print("Middle Column Sum:", sum(middle_column))

# Q10 List Transform Challange
data = [15, 5, 25, 10, 35, 20, 30]

unique_sorted = sorted(set(data))
largest_three = unique_sorted[-3:]
smallest_two = unique_sorted[:2][::-1]
result = largest_three + smallest_two

print("Sorted Unique Values:", unique_sorted)
print("Largest Three:", largest_three)
print("Smallest Two:", smallest_two)
print("Final Result:", result)
